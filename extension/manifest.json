{
  "manifest_version": 3,
  "name": "CGW Studio Batch Helper",
  "version": "0.1.0",
  "description": "Fills each platform's upload form from the CGW Content Studio batch. You still press Schedule.",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_title": "CGW batch"},
  "side_panel": {"default_path": "sidepanel.html"},
  "options_page": "options.html",
  "background": {"service_worker": "background.js"},
  "permissions": ["sidePanel", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://studio.youtube.com/*",
    "https://www.tiktok.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.linkedin.com/*",
    "https://business.google.com/*",
    "https://www.google.com/*",
    "https://www.instagram.com/*",
    "https://www.facebook.com/*",
    "https://business.facebook.com/*",
    "https://www.threads.net/*",
    "https://www.threads.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
